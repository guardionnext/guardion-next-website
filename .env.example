# Resend — contact form email delivery
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address. Must be on a domain verified in Resend.
# Before verifying guardion.com.au you can use Resend's shared sender:
#   CONTACT_FROM_EMAIL="Guardion <onboarding@resend.dev>"
# After verifying the domain, use something like:
#   CONTACT_FROM_EMAIL="Guardion Enquiries <enquiries@guardion.com.au>"
CONTACT_FROM_EMAIL="Guardion <onboarding@resend.dev>"

# Where enquiries are delivered. Defaults to info@guardion.com.au if unset.
CONTACT_TO_EMAIL="info@guardion.com.au"
